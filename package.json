{
  "name": "Matalk",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "android": "npx @react-native-community/cli run-android",
    "ios": "npx @react-native-community/cli run-ios",
    "lint": "eslint .",
    "start": "npx @react-native-community/cli start --reset-cache",
    "test": "jest",
    "copyHermes": "./copy_hermes_dsym.sh Matalk DD-MM-2025, HH.MM.xcarchive",
    "cleanAndroid": "cd android && ./gradlew clean && cd ..",
    "buildAndroid": "cd android && ./gradlew assembleRelease && cd ..",
    "openStudio": "open -a 'Android Studio' .",
    "runAndroid": "npx @react-native-community/cli run-android",
    "deleteDerivedData": "rm -rf ~/Library/Developer/Xcode/DerivedData/Matalk-*",
    "cleanIos": "cd ios && rm -rf build && pod install && cd ..",
    "shake": "adb shell input keyevent 82",
    "postinstall": "bash scripts/postinstall-fixes.sh",
    "iep:mock-audit": "node scripts/iep-mock-coverage.js --weeks 12 && node scripts/iep-reconcile-mock.js --dry-run",
    "iep:test": "jest __tests__/iep",
    "iep:sample-report": "IEP_PDF_OUT=docs/iep-samples jest __tests__/iep/export/pdfReport.test.ts",
    "iep:bundle-mock-data": "node scripts/iep-bundle-mock-data.js"
  },
  "dependencies": {
