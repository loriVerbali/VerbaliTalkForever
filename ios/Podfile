# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

require_relative '../node_modules/react-native-permissions/scripts/setup'

# Add permissions you need
def permission_setup
  setup_permissions([
    'Microphone',
    'SpeechRecognition',
    'LocationWhenInUse',  
    'Camera',
    'PhotoLibrary'
  ])
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'matalkforever' do
  config = use_native_modules!
  permission_setup

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Workaround for a React Native prebuilt-binaries bug (present in RN 0.86.x and still on upstream main).
    # Xcode swaps React-Core-prebuilt / ReactNativeDependencies between their Debug and Release xcframeworks
    # via a `.last_build_configuration` marker file. The CocoaPods pod-directory cleaner deletes that dot-file
    # on any `pod install` that installs/updates a pod (the podspec preserve_paths "**/*.*" does not match
    # dot-files) while leaving a previously swapped *Release* framework in place. The RN swap scripts then
    # assume "no marker == Debug is installed", so Debug builds fail to link with undefined
    # facebook::react::Sealable / DebugStringConvertible symbols.
    # Fix: whenever a marker is missing, force-reinstall the Debug flavor so that assumption holds again.
    pods_root = installer.sandbox.root.to_s
    react_native_path = File.expand_path(config[:reactNativePath], Pod::Config.instance.installation_root)
    [
      ["React-Core-prebuilt", File.join(react_native_path, "scripts", "replace-rncore-version.js")],
      ["ReactNativeDependencies", File.join(react_native_path, "third-party-podspecs", "replace_dependencies_version.js")],
    ].each do |pod_name, script|
      pod_dir = File.join(pods_root, pod_name)
      marker = File.join(pod_dir, ".last_build_configuration")
      next if File.exist?(marker) || !File.directory?(pod_dir) || !File.exist?(script)
      spec = installer.analysis_result.specifications.find { |s| s.name == pod_name }
      next if spec.nil?
      Pod::UI.puts "[Prebuilt] #{pod_name}: no .last_build_configuration marker found, reinstalling the Debug xcframework".yellow
      File.write(marker, "Release") # make the RN script re-extract the Debug tarball (cached in Pods/*-artifacts)
      ok = system("node", script, "-c", "Debug", "-r", spec.version.to_s, "-p", pods_root, :chdir => pods_root)
      Pod::UI.warn "[Prebuilt] Failed to reinstall the Debug xcframework for #{pod_name}; the Xcode script phase will retry on the next build" unless ok
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
         config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end
    end    

    # This is necessary for Xcode 14+
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
          config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        end
      end
    end


    # Workaround for Xcode 26: newer Apple Clang breaks consteval in fmt 11.0.2.
    # Patch base.h to disable consteval since the header doesn't check for pre-defined FMT_USE_CONSTEVAL.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')

    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      unless content.include?('Xcode 26 workaround')
        patched = content.gsub(
          /^(#elif defined\(__cpp_consteval\)\n#  define FMT_USE_CONSTEVAL) 1/,
          "// Xcode 26 workaround: disable consteval\n\\1 0"
        )
        if patched != content
          File.chmod(0644, fmt_base)
          File.write(fmt_base, patched)
        end
      end
    end
    
  end
end
